# =============================================================================
# Kịch Bản Sát - Backend Environment Variables Template
# Copy this file to .env or configure your system environment variables.
# NEVER commit real credentials or .env files to Git.
# =============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kichbansat_db
SPRING_DATASOURCE_USERNAME=kichbansat_app
SPRING_DATASOURCE_PASSWORD=kichbansat_secret

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
